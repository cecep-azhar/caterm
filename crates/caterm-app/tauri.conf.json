{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CATerm",
  "version": "2.0.9",
  "identifier": "com.fathforce.caterm",
  "build": {
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "CATerm",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
