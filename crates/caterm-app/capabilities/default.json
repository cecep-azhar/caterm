{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "allow-list-hosts",
    "allow-save-host",
    "allow-delete-host",
    "allow-list-groups",
    "allow-save-group",
    "allow-delete-group",
    "allow-list-teams",
    "allow-save-team",
    "allow-delete-team",
    "allow-list-investigations",
    "allow-save-investigation",
    "allow-delete-investigation",
    "allow-list-snippets",
    "allow-save-snippet",
    "allow-delete-snippet",
    "allow-list-tunnels",
    "allow-save-tunnel",
    "allow-delete-tunnel",
    "allow-start-tunnel",
    "allow-stop-tunnel",
    "allow-poll-active-metrics",
    "allow-list-remote-dir",
    "allow-read-remote-file",
    "allow-write-remote-file",
    "allow-mkdir-remote-dir",
    "allow-delete-remote-file",
    "allow-sftp-rename",
