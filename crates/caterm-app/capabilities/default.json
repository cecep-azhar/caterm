{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-hosts",
    "allow-save-host",
    "allow-delete-host",
    "allow-list-groups",
    "allow-save-group",
    "allow-delete-group",
    "allow-list-snippets",
    "allow-save-snippet",
    "allow-delete-snippet",
    "allow-validate-vault-password",
    "allow-is-vault-initialized",
    "allow-reset-vault",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-disconnect",
    "allow-get-ai-settings",
    "allow-save-ai-settings",
    "allow-ai-generate-plan",
    "allow-ai-execute-step"
  ]
}
